<?xml version="1.0" encoding="UTF-8"?>
<project name="CielosLimpios" default="run" basedir=".">
    <description>Operación Cielos Limpios: simulación de una flota de drones.</description>
    <property file="nbproject/project.properties"/>

    <target name="init">
        <mkdir dir="${build.classes.dir}"/>
        <mkdir dir="${build.test.classes.dir}"/>
        <mkdir dir="${dist.dir}"/>
    </target>

    <target name="compile" depends="init" description="Compilar el código fuente con Java 17.">
        <javac srcdir="${src.dir}" destdir="${build.classes.dir}"
               release="${javac.release}" encoding="${source.encoding}"
               includeantruntime="false" debug="true"/>
    </target>

    <target name="run" depends="compile" description="Ejecutar la simulación en la consola.">
        <java classname="${main.class}" fork="true" failonerror="true">
            <classpath path="${build.classes.dir}"/>
            <jvmarg value="-Dfile.encoding=UTF-8"/>
            <arg line="${application.args}"/>
        </java>
    </target>

    <target name="compile-test" depends="compile">
        <javac srcdir="${test.src.dir}" destdir="${build.test.classes.dir}"
               release="${javac.release}" encoding="${source.encoding}"
               includeantruntime="false" debug="true">
            <classpath path="${build.classes.dir}"/>
        </javac>
    </target>

    <target name="test" depends="compile-test" description="Ejecutar las pruebas sin dependencias externas.">
        <java classname="${test.main.class}" fork="true" failonerror="true">
            <classpath>
                <pathelement location="${build.classes.dir}"/>
                <pathelement location="${build.test.classes.dir}"/>
            </classpath>
            <jvmarg value="-ea"/>
            <jvmarg value="-Dfile.encoding=UTF-8"/>
        </java>
    </target>

    <target name="jar" depends="compile" description="Crear el archivo JAR ejecutable.">
        <jar destfile="${dist.jar}" basedir="${build.classes.dir}">
            <manifest>
                <attribute name="Main-Class" value="${main.class}"/>
            </manifest>
        </jar>
    </target>

    <target name="clean" description="Eliminar los archivos generados.">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>
</project>
